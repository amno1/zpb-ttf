(in-package #:zpb-otf/codegen)

(eval-when (:compile-toplevel :load-toplevel :execute)
  (unless (find-package :zpb-otf)
    (make-package :zpb-otf :use '(:cl)))
  (import (mapcar (lambda (s) (intern s :zpb-otf))
                  '("TABLE" "REC" "OFFSET" "POS" "OFF" "CNT" "FMT" "INDEX" "FLAGS" "ARG" "VAL" "SUB"
                    "%TABLE-FONT-DATA" "%TABLE-OFFSET" "%TABLE-LENGTH"
                    "%RECORD-FONT-DATA" "%RECORD-OFFSET"))
          :zpb-otf/codegen)
  (unless (find-package :zpb-otf/schema)
    (make-package :zpb-otf/schema :use '(:cl)))
  (export (mapcar (lambda (s) (intern s :zpb-otf/schema))
                  '("TABLE" "RECORD" "FORMAT" "FLAGS" "ENUM" "FIELD" "VARIANT" "ARRAY"))
          :zpb-otf/schema))

(defvar *known-tables* (make-hash-table :test 'equal))
(defvar *known-records* (make-hash-table :test 'equal))
(defvar *known-formats* (make-hash-table :test 'equal))
(defvar *known-enums* (make-hash-table :test 'equal))
(defvar *known-flags* (make-hash-table :test 'equal))
(defvar *record-size-cache* (make-hash-table :test 'equal))
(defvar *exports* '())
(defvar *module-name* nil)

(defun reset-registries ()
  (clrhash *known-tables*)
  (clrhash *known-records*)
  (clrhash *known-formats*)
  (clrhash *known-enums*)
  (clrhash *known-flags*)
  (clrhash *record-size-cache*))

(defparameter *primitive-types*
  '((:u8              :size 1 :reader font-data-read-u8)
    (:i8              :size 1 :reader font-data-read-i8)
    (:u16             :size 2 :reader font-data-read-u16)
    (:i16             :size 2 :reader font-data-read-i16)
    (:u24             :size 3 :reader font-data-read-u24)
    (:glyph-id24      :size 3 :reader font-data-read-u24)
    (:u32             :size 4 :reader font-data-read-u32)
    (:i32             :size 4 :reader font-data-read-i32)
    (:fixed           :size 4 :reader font-data-read-fixed)
    (:version16-dot16 :size 4 :reader font-data-read-fixed)
    (:f2-dot14        :size 2 :reader font-data-read-f2dot14)
    (:f-word          :size 2 :reader font-data-read-fword)
    (:uf-word         :size 2 :reader font-data-read-ufword)
    (:glyph-id16      :size 2 :reader font-data-read-u16)
    (:name-id         :size 2 :reader font-data-read-u16)
    (:tag             :size 4 :reader font-data-read-tag-string)
    (:major-minor     :size 4 :reader font-data-read-u32)
    (:long-date-time  :size 8 :reader font-data-read-u64)))

(defun resolve-type-info (type-sym)
  (when (symbolp type-sym)
    (let* ((name (string-upcase (symbol-name type-sym)))
           (key (intern name :keyword))
           (prim (cdr (assoc key *primitive-types*))))
      (if prim
          prim
          (let ((underlying (or (gethash name *known-enums*)
                                (gethash name *known-flags*))))
            (when underlying
              (resolve-type-info underlying)))))))

(defun offset-type-info (offset-sym)
  (let ((name (string-upcase (symbol-name offset-sym))))
    (cond
      ((search "32" name) (values 4 'font-data-read-u32))
      ((search "24" name) (values 3 'font-data-read-u24))
      (t (values 2 'font-data-read-u16)))))

(defun zsym (name)
  (intern (string-upcase (string name)) :zpb-otf))

(defun compute-record-size (rec-sym)
  (when (symbolp rec-sym)
    (let ((rec (gethash (string-upcase (string rec-sym)) *known-records*)))
      (if (null rec)
          nil
          (let ((total 0))
            (dolist (f (cddr rec) total)
              (when (and (consp f) (string-equal (car f) "field"))
                (let* ((ftype (third f))
                       (sz (cond
                             ((consp ftype)
                              (let ((head (string-upcase (string (car ftype)))))
                                (cond
                                  ((string-equal head "ARRAY")
                                   (let ((cnt (get-prop :count (cdddr f)))
                                         (el (second ftype)))
                                     (if (numberp cnt)
                                         (let ((esz (or (getf (resolve-type-info el) :size)
                                                        (compute-record-size el))))
                                           (if esz (* cnt esz) nil))
                                         nil)))
                                  ((search "OFFSET" head) (nth-value 0 (offset-type-info (car ftype))))
                                  (t nil))))
                             (t
                              (let ((pinfo (resolve-type-info ftype)))
                                (if pinfo
                                    (getf pinfo :size)
                                    (compute-record-size ftype)))))))
                  (if sz
                      (incf total sz)
                      (return-from compute-record-size nil))))))))))

(defun resolve-record-size (rec-sym)
  (when (symbolp rec-sym)
    (let ((key (string-upcase (string rec-sym))))
      (or (gethash key *record-size-cache*)
          (setf (gethash key *record-size-cache*)
                (compute-record-size rec-sym))))))

(defun register-sexp-item (form)
  (when (consp form)
    (let ((kind (string-upcase (string (car form)))))
      (cond
        ((string-equal kind "TABLE")
         (setf (gethash (string-upcase (string (second form))) *known-tables*) form))
        ((string-equal kind "RECORD")
         (setf (gethash (string-upcase (string (second form))) *known-records*) form))
        ((or (string-equal kind "FORMAT") (string-equal kind "FORMAT-TABLE"))
         (setf (gethash (string-upcase (string (third form))) *known-formats*) form))
        ((string-equal kind "ENUM")
         (setf (gethash (string-upcase (string (third form))) *known-enums*) (second form)))
        ((string-equal kind "FLAGS")
         (setf (gethash (string-upcase (string (third form))) *known-flags*) (second form)))))))

(defun find-table-format-value (tbl-sym)
  (let ((tbl (gethash (string-upcase (string tbl-sym)) *known-tables*)))
    (when tbl
      (dolist (f (cddr tbl))
        (when (and (consp f) (string-equal (car f) "field"))
          (let ((fmt-pos (position :format f)))
            (when fmt-pos
              (return (nth (1+ fmt-pos) f)))))))))

(defun find-field (fname table-form)
  (find fname (cddr table-form)
        :key (lambda (f) (and (consp f) (second f)))
        :test (lambda (a b) (and a b (string-equal a b)))))

(defun get-prop (key plist &optional default)
  (let ((pos (position key plist)))
    (if pos (nth (1+ pos) plist) default)))

(defun make-offset-form (base fixed dynamic-terms)
  (cond
    ((null dynamic-terms)
     (if (zerop fixed) base `(+ ,base ,fixed)))
    ((zerop fixed)
     `(+ ,base ,@dynamic-terms))
    (t
     `(+ ,base ,fixed ,@dynamic-terms))))

(defun count-to-lisp-form (count-expr struct-name table-form var-sym)
  (cond
    ((null count-expr) nil)
    ((numberp count-expr) count-expr)
    ((eq count-expr :remainder) nil)
    ((symbolp count-expr)
     (let ((fld (find-field count-expr table-form)))
       (when fld
         `(,(zsym (format nil "~A-~A" struct-name count-expr)) ,var-sym))))
    ((consp count-expr)
     (let* ((op (intern (string-upcase (symbol-name (car count-expr))) :keyword))
            (args (mapcar (lambda (a) (count-to-lisp-form a struct-name table-form var-sym))
                          (cdr count-expr))))
       (when (every #'identity args)
         (case op
           (:add `(+ ,@args))
           (:subtract `(max 0 (- ,@args)))
           (:half `(floor ,(car args) 2))
           (:add-multiply `(* (+ ,(first args) ,(second args)) ,(third args)))
           (:multiply-add `(+ (* ,(first args) ,(second args)) ,(third args)))
           (:subtract-add-two `(+ (max 0 (- ,(first args) ,(second args))) 2))
           (:bitmap-len `(ceiling ,(car args) 8))
           (otherwise nil)))))))

;;; --- Emitters as Pure Lisp Forms ---

(defun emit-enum (form)
  (let* ((name (third form))
         (doc (get-prop :doc (cdddr form)))
         (variants (remove-if (lambda (x) (or (not (consp x)) (keywordp (car x)))) (cdddr form)))
         (forms '()))
    (dolist (v variants)
      (let ((cname (zsym (format nil "+~A-~A+" name (car v)))))
        (pushnew (symbol-name cname) *exports* :test #'string=)
        (push `(define-constant ,cname ,(cadr v) ,@(when doc (list doc))) forms)))
    (nreverse forms)))

(defun emit-flags (form)
  (let* ((name (third form))
         (doc (get-prop :doc (cdddr form)))
         (flags (remove-if (lambda (x) (or (not (consp x)) (keywordp (car x)))) (cdddr form)))
         (forms '()))
    (dolist (fl flags)
      (let ((cname (zsym (format nil "+~A-~A+" name (car fl)))))
        (pushnew (symbol-name cname) *exports* :test #'string=)
        (push `(define-constant ,cname ,(cadr fl) ,@(when doc (list doc))) forms)))
    (nreverse forms)))

(defun emit-record (form)
  (let* ((name (second form))
         (struct-name (zsym name))
         (ctor-name (zsym (format nil "%MAKE-~A" name)))
         (pred-name (zsym (format nil "~A-P" name)))
         (doc (get-prop :doc (cddr form)))
         (fields (remove-if-not (lambda (x) (and (consp x) (string-equal (car x) "field"))) (cddr form)))
         (offset 0)
         (has-dynamic-array nil)
         (declaims '())
         (forms '()))
    (pushnew (symbol-name struct-name) *exports* :test #'string=)
    (pushnew (symbol-name pred-name) *exports* :test #'string=)
    (push `(defstruct (,struct-name (:include record-ref)
                                   (:constructor ,ctor-name (%record-font-data %record-offset)))
             ,@(when doc (list doc)))
          forms)
    (dolist (f fields)
      (let* ((fname (second f))
             (ftype (third f))
             (fdoc (get-prop :doc (cdddr f)))
             (acc-name (zsym (format nil "~A-~A" struct-name fname)))
             (tinfo (resolve-type-info ftype)))
        (pushnew (symbol-name acc-name) *exports* :test #'string=)
        (push acc-name declaims)
        (cond
          ;; 1. Primitive scalar field
          (tinfo
           (let ((size (getf tinfo :size))
                 (reader (getf tinfo :reader)))
             (push `(defun ,acc-name (rec)
                      ,@(when fdoc (list fdoc))
                      (declare (type ,struct-name rec))
                      (,reader (record-ref-font-data rec)
                               ,(if (zerop offset)
                                    '(record-ref-offset rec)
                                    `(+ (record-ref-offset rec) ,offset))))
                   forms)
             (incf offset size)))

          ;; 2. Offset field: (offset16 target), (offset24 target), (offset32 target)
          ((and (consp ftype) (search "OFFSET" (string-upcase (string (car ftype)))))
           (multiple-value-bind (off-size off-reader) (offset-type-info (car ftype))
             (push `(defun ,acc-name (rec)
                      ,@(when fdoc (list fdoc))
                      (declare (type ,struct-name rec))
                      (,off-reader (record-ref-font-data rec)
                                   ,(if (zerop offset)
                                        '(record-ref-offset rec)
                                        `(+ (record-ref-offset rec) ,offset))))
                   forms)
             (incf offset off-size)))

          ;; 3. Array field: (array elem-type)
          ((and (consp ftype) (string-equal (string (car ftype)) "ARRAY"))
           (let* ((elem-type (second ftype))
                  (count-attr (get-prop :count (cdddr f)))
                  (count-acc (zsym (format nil "~A-COUNT" acc-name)))
                  (ref-acc (zsym (format nil "~A-REF" acc-name)))
                  (elem-tinfo (resolve-type-info elem-type))
                  (elem-bytes (cond
                                (elem-tinfo (getf elem-tinfo :size))
                                ((and (consp elem-type) (search "OFFSET" (string-upcase (string (car elem-type)))))
                                 (nth-value 0 (offset-type-info (car elem-type))))
                                (t (resolve-record-size elem-type))))
                  (elem-reader (cond
                                 (elem-tinfo (getf elem-tinfo :reader))
                                 ((and (consp elem-type) (search "OFFSET" (string-upcase (string (car elem-type)))))
                                  (nth-value 1 (offset-type-info (car elem-type))))
                                 (t nil)))
                  (elem-ctor (when (null elem-reader) (zsym (format nil "%MAKE-~A" elem-type)))))
             (pushnew (symbol-name count-acc) *exports* :test #'string=)
             (pushnew (symbol-name ref-acc) *exports* :test #'string=)
             ;; Count getter
             (cond
               ((and count-attr (symbolp count-attr))
                (let ((internal-fld (find-field count-attr form)))
                  (if internal-fld
                      (let ((count-fld-acc (zsym (format nil "~A-~A" struct-name count-attr))))
                        (push `(defun ,count-acc (rec)
                                 ,@(when fdoc (list fdoc))
                                 (declare (type ,struct-name rec))
                                 (,count-fld-acc rec))
                              forms))
                      (let ((arg-name (zsym count-attr)))
                        (push `(defun ,count-acc (rec &optional ,arg-name)
                                 ,@(when fdoc (list fdoc))
                                 (declare (type ,struct-name rec))
                                 ,arg-name)
                              forms)))))
               ((numberp count-attr)
                (push `(defun ,count-acc (rec)
                         ,@(when fdoc (list fdoc))
                         (declare (type ,struct-name rec))
                         ,count-attr)
                      forms))
               (t
                (push `(defun ,count-acc (rec &optional count)
                         ,@(when fdoc (list fdoc))
                         (declare (type ,struct-name rec))
                         count)
                      forms)))
             ;; Ref getter
             (let ((bytes (or elem-bytes 1))
                   (off-expr (if (zerop offset)
                                 '(record-ref-offset rec)
                                 `(+ (record-ref-offset rec) ,offset))))
               (push `(defun ,ref-acc (rec index)
                        ,@(when fdoc (list fdoc))
                        (declare (type ,struct-name rec) (type (unsigned-byte 32) index))
                        (let ((pos (+ ,off-expr (* index ,bytes))))
                          ,(if elem-reader
                               `(,elem-reader (record-ref-font-data rec) pos)
                               `(,elem-ctor (record-ref-font-data rec) pos))))
                     forms))
             (if (numberp count-attr)
                 (incf offset (* count-attr (or elem-bytes 1)))
                 (setf has-dynamic-array t))))

          ;; 4. Nested record or other type
          (t
           (let ((rsize (resolve-record-size ftype)))
             (when rsize
               (let ((rec-ctor (zsym (format nil "%MAKE-~A" ftype))))
                 (push `(defun ,acc-name (rec)
                          ,@(when fdoc (list fdoc))
                          (declare (type ,struct-name rec))
                          (,rec-ctor (record-ref-font-data rec)
                                     ,(if (zerop offset)
                                          '(record-ref-offset rec)
                                          `(+ (record-ref-offset rec) ,offset))))
                       forms)
                 (incf offset rsize))))))))
    (unless has-dynamic-array
      (let ((size-const (zsym (format nil "+~A-SIZE+" name))))
        (pushnew (symbol-name size-const) *exports* :test #'string=)
        (push `(define-constant ,size-const ,offset) forms)))
    (when declaims
      (push `(declaim (inline ,@(nreverse declaims))) (cdr forms)))
    (nreverse forms)))

(defun emit-format (form)
  (let* ((disc-type (second form))
         (name (third form))
         (lisp-name (zsym name))
         (read-name (zsym (format nil "READ-~A" name)))
         (disc-offset (or (get-prop :offset (cdddr form)) 0))
         (doc (get-prop :doc (cdddr form)))
         (reader (getf (resolve-type-info disc-type) :reader 'font-data-read-u16))
         (variants (remove-if-not (lambda (x) (and (consp x) (string-equal (car x) "variant"))) (cdddr form))))
    (pushnew (symbol-name read-name) *exports* :test #'string=)
    (cond
      ((string-equal (symbol-name name) "GLYPH")
       (list `(defun ,read-name (font-data offset &optional (length (- (font-data-length font-data) offset)))
                ,@(when doc (list doc))
                (declare (ignorable length))
                (let ((fmt (,reader font-data (+ offset ,disc-offset))))
                  (cond
                    ((>= fmt 0) (,(zsym "READ-SIMPLE-GLYPH") font-data offset length))
                    ((< fmt 0) (,(zsym "READ-COMPOSITE-GLYPH") font-data offset length))
                    (t (error 'unsupported-format-error :format fmt :table ',lisp-name)))))))

      ((string-equal (symbol-name name) "DEVICE-OR-VARIATION-INDEX")
       (list `(defun ,read-name (font-data offset &optional (length (- (font-data-length font-data) offset)))
                ,@(when doc (list doc))
                (declare (ignorable length))
                (let ((fmt (,reader font-data (+ offset ,disc-offset))))
                  (if (= fmt #x8000)
                      (,(zsym "READ-VARIATION-INDEX") font-data offset length)
                      (,(zsym "READ-DEVICE") font-data offset length))))))

      (t
       (let ((cases '()))
         (dolist (v variants)
           (let* ((vname (symbol-name (second v)))
                  (target (third v))
                  (digits (remove-if-not #'digit-char-p vname))
                  (fmt-val (or (when (plusp (length digits)) (parse-integer digits))
                               (find-table-format-value target))))
             (unless fmt-val
               (error "Format variant ~A in format ~A has no numeric discriminator" vname name))
             (push `(,fmt-val (,(zsym (format nil "READ-~A" target)) font-data offset length)) cases)))
         (list `(defun ,read-name (font-data offset &optional (length (- (font-data-length font-data) offset)))
                  ,@(when doc (list doc))
                  (declare (ignorable length))
                  (let ((fmt (,reader font-data (+ offset ,disc-offset))))
                    (case fmt
                      ,@(nreverse cases)
                      (otherwise (error 'unsupported-format-error :format fmt :table ',lisp-name)))))))))))

(defun emit-table (form)
  (let* ((name (second form))
         (struct-name (zsym name))
         (ctor-name (zsym (format nil "%MAKE-~A" name)))
         (pred-name (zsym (format nil "~A-P" name)))
         (read-name (zsym (format nil "READ-~A" name)))
         (san-name (zsym (format nil "SANITIZE-~A" name)))
         (tag (get-prop :tag (cddr form)))
         (doc (get-prop :doc (cddr form)))
         (fields (remove-if-not (lambda (x) (and (consp x) (string-equal (car x) "field"))) (cddr form)))
         (min-size 0)
         (fixed-offset 0)
         (dynamic-terms '())
         (array-bounds-checks '())
         (declaims '())
         (forms '()))

    (pushnew (symbol-name struct-name) *exports* :test #'string=)
    (pushnew (symbol-name pred-name) *exports* :test #'string=)
    (pushnew (symbol-name read-name) *exports* :test #'string=)
    (pushnew (symbol-name san-name) *exports* :test #'string=)

    (push `(defstruct (,struct-name (:include table-ref)
                                   (:constructor ,ctor-name (%table-font-data %table-offset %table-length)))
             ,@(when doc (list doc)))
          forms)

    (when tag
      (let ((tag-const (zsym (format nil "+~A-TAG+" struct-name))))
        (pushnew (symbol-name tag-const) *exports* :test #'string=)
        (push `(define-constant ,tag-const ,tag) forms)))

    ;; Pre-collect exports & declaims
    (dolist (f fields)
      (let* ((fname (second f))
             (acc-name (zsym (format nil "~A-~A" struct-name fname)))
             (ftype (third f))
             (is-array (and (consp ftype) (string-equal (car ftype) "array")))
             (is-offset (and (consp ftype) (search "OFFSET" (string-upcase (string (car ftype)))))))
        (pushnew (symbol-name acc-name) *exports* :test #'string=)
        (push acc-name declaims)
        (when is-array
          (let* ((count-acc (zsym (format nil "~A-COUNT" acc-name)))
                 (colliding (find-field (format nil "~A-COUNT" fname) form)))
            (if colliding
                (push (zsym (format nil "~A-ARRAY-COUNT" acc-name)) declaims)
                (push count-acc declaims))))
        (when is-offset
          (push (zsym (format nil "~A-OFFSET" acc-name)) declaims))))

    (dolist (f fields)
      (let* ((fname (second f))
             (ftype (third f))
             (fdoc (get-prop :doc (cdddr f)))
             (since-ver (get-prop :since-version (cdddr f)))
             (acc-name (zsym (format nil "~A-~A" struct-name fname)))
             (is-array (and (consp ftype) (string-equal (car ftype) "array")))
             (off-expr (make-offset-form '(table-ref-offset table) fixed-offset dynamic-terms))
             (raw-off-expr (make-offset-form 'offset fixed-offset dynamic-terms)))
        (cond
          ;; Array Field
          (is-array
           (let* ((inner-type (second ftype))
                  (is-offset-elem (and (consp inner-type) (search "OFFSET" (string-upcase (string (car inner-type))))))
                  (elem-type (if is-offset-elem (second inner-type) inner-type))
                  (elem-info (resolve-type-info elem-type))
                  (elem-size (cond
                               (is-offset-elem (nth-value 0 (offset-type-info (car inner-type))))
                               (elem-info (getf elem-info :size))
                               (t (resolve-record-size elem-type))))
                  (elem-bytes (or elem-size 1))
                  (count-attr (get-prop :count (cdddr f)))
                  (lisp-count-expr (count-to-lisp-form count-attr struct-name form 'table))
                  (count-acc (zsym (format nil "~A-COUNT" acc-name)))
                  (ref-acc (zsym (format nil "~A-REF" acc-name)))
                  (colliding-field (find-field (format nil "~A-COUNT" fname) form))
                  (actual-count-call nil))

             ;; Count getter
             (cond
               ((numberp count-attr)
                (pushnew (symbol-name count-acc) *exports* :test #'string=)
                (let ((array-bytes (* count-attr elem-bytes)))
                  (push `(defun ,count-acc (table)
                           ,@(when fdoc (list fdoc))
                           (declare (ignore table))
                           ,count-attr)
                        forms)
                  (incf fixed-offset array-bytes)
                  (when (and (null dynamic-terms) (null since-ver))
                    (incf min-size array-bytes))
                  (setf actual-count-call count-attr)))

               (colliding-field
                (let ((colliding-acc (zsym (format nil "~A-~A" struct-name (second colliding-field)))))
                  (if (and lisp-count-expr (equal lisp-count-expr `(,colliding-acc table)))
                      (setf actual-count-call `(,colliding-acc table))
                      (let ((array-count-acc (zsym (format nil "~A-ARRAY-COUNT" acc-name))))
                        (pushnew (symbol-name array-count-acc) *exports* :test #'string=)
                        (push `(defun ,array-count-acc (table)
                                 ,@(when fdoc (list fdoc))
                                 ,lisp-count-expr)
                              forms)
                        (setf actual-count-call `(,array-count-acc table)))))
                (push `(* ,actual-count-call ,elem-bytes) dynamic-terms))

               (t
                (pushnew (symbol-name count-acc) *exports* :test #'string=)
                (cond
                  (lisp-count-expr
                   (push `(defun ,count-acc (table)
                            ,@(when fdoc (list fdoc))
                            ,lisp-count-expr)
                         forms))
                  ((and count-attr (not (eq count-attr :remainder)))
                   (let ((arg-name (zsym (if (symbolp count-attr) count-attr "COUNT"))))
                     (push `(defun ,count-acc (table &optional ,arg-name)
                              ,@(when fdoc (list fdoc))
                              (or ,arg-name (max 0 (floor (- (table-ref-length table) ,off-expr) ,elem-bytes))))
                           forms)))
                  (t
                   (push `(defun ,count-acc (table)
                            ,@(when fdoc (list fdoc))
                            (max 0 (floor (- (table-ref-length table) ,off-expr) ,elem-bytes)))
                         forms)))
                (setf actual-count-call `(,count-acc table))
                (push `(* ,actual-count-call ,elem-bytes) dynamic-terms)))

             (pushnew (symbol-name ref-acc) *exports* :test #'string=)

             ;; Bounds check in sanitize
             (when (and (null (cdr dynamic-terms)) elem-size (> elem-size 0))
               (when (symbolp count-attr)
                 (let ((internal-fld (find-field count-attr form)))
                   (when internal-fld
                     (let ((raw-fn (zsym (format nil "~A-~A-RAW" struct-name count-attr)))
                           (int-since (get-prop :since-version (cdddr internal-fld))))
                       (if int-since
                           (push `(when (>= length ,fixed-offset)
                                    (let ((cnt (,raw-fn font-data offset)))
                                      (unless (and (<= (+ ,fixed-offset (* cnt ,elem-size)) length)
                                                   (font-data-valid-range-p font-data offset (+ ,fixed-offset (* cnt ,elem-size))))
                                        (error 'font-out-of-bounds-error :pos offset :size (+ ,fixed-offset (* cnt ,elem-size)) :length (font-data-length font-data)))))
                                 array-bounds-checks)
                           (push `(let ((cnt (,raw-fn font-data offset)))
                                    (unless (and (<= (+ ,fixed-offset (* cnt ,elem-size)) length)
                                                 (font-data-valid-range-p font-data offset (+ ,fixed-offset (* cnt ,elem-size))))
                                      (error 'font-out-of-bounds-error :pos offset :size (+ ,fixed-offset (* cnt ,elem-size)) :length (font-data-length font-data))))
                                 array-bounds-checks)))))))

             ;; Element getter
             (cond
               (is-offset-elem
                (let* ((off-reader (nth-value 1 (offset-type-info (car inner-type))))
                       (target elem-type)
                       (target-known (or (gethash (string-upcase (string target)) *known-tables*)
                                         (gethash (string-upcase (string target)) *known-formats*))))
                  (if target-known
                      (push `(defun ,ref-acc (table index)
                               ,@(when fdoc (list fdoc))
                               (declare (type ,struct-name table) (type (unsigned-byte 32) index))
                               (let* ((pos (+ ,off-expr (* index ,elem-bytes))))
                                 (unless (<= (+ pos ,elem-bytes) (+ (table-ref-offset table) (table-ref-length table)))
                                   (error 'font-out-of-bounds-error :pos pos :size ,elem-bytes :length (table-ref-length table)))
                                 (let ((off (,off-reader (table-ref-font-data table) pos)))
                                   (unless (zerop off)
                                     (,(zsym (format nil "READ-~A" target))
                                      (table-ref-font-data table)
                                      (+ (table-ref-offset table) off))))))
                            forms)
                      (push `(defun ,ref-acc (table index)
                               ,@(when fdoc (list fdoc))
                               (declare (type ,struct-name table) (type (unsigned-byte 32) index))
                               (let* ((pos (+ ,off-expr (* index ,elem-bytes))))
                                 (unless (<= (+ pos ,elem-bytes) (+ (table-ref-offset table) (table-ref-length table)))
                                   (error 'font-out-of-bounds-error :pos pos :size ,elem-bytes :length (table-ref-length table)))
                                 (let ((off (,off-reader (table-ref-font-data table) pos)))
                                   (unless (zerop off)
                                     (font-data-slice (table-ref-font-data table) (+ (table-ref-offset table) off))))))
                            forms))))

               (elem-info
                (let ((reader (getf elem-info :reader)))
                  (push `(defun ,ref-acc (table index)
                           ,@(when fdoc (list fdoc))
                           (declare (type ,struct-name table) (type (unsigned-byte 32) index))
                           (let ((pos (+ ,off-expr (* index ,elem-bytes))))
                             (unless (<= (+ pos ,elem-bytes) (+ (table-ref-offset table) (table-ref-length table)))
                               (error 'font-out-of-bounds-error :pos pos :size ,elem-bytes :length (table-ref-length table)))
                             (,reader (table-ref-font-data table) pos)))
                        forms)))

               (elem-size
                (let ((rec-ctor (zsym (format nil "%MAKE-~A" elem-type))))
                  (push `(defun ,ref-acc (table index)
                           ,@(when fdoc (list fdoc))
                           (declare (type ,struct-name table) (type (unsigned-byte 32) index))
                           (let ((pos (+ ,off-expr (* index ,elem-bytes))))
                             (unless (<= (+ pos ,elem-bytes) (+ (table-ref-offset table) (table-ref-length table)))
                               (error 'font-out-of-bounds-error :pos pos :size ,elem-bytes :length (table-ref-length table)))
                             (,rec-ctor (table-ref-font-data table) pos)))
                        forms))))

             ;; For u8 arrays, emit bytes slice
             (when (string-equal (string elem-type) "U8")
               (let ((bytes-acc (zsym (format nil "~A-BYTES" acc-name))))
                 (pushnew (symbol-name bytes-acc) *exports* :test #'string=)
                 (push `(defun ,bytes-acc (table)
                          ,@(when fdoc (list fdoc))
                          (font-data-slice (table-ref-font-data table) ,off-expr ,actual-count-call))
                       forms)))))

          ;; Offset field
          ((and (consp ftype) (search "OFFSET" (string-upcase (string (car ftype)))))
           (multiple-value-bind (off-size off-reader) (offset-type-info (car ftype))
             (let* ((target (second ftype))
                    (target-known (or (gethash (string-upcase (string target)) *known-tables*)
                                      (gethash (string-upcase (string target)) *known-formats*)))
                    (raw-acc (zsym (format nil "~A-OFFSET" acc-name))))
               (pushnew (symbol-name raw-acc) *exports* :test #'string=)
               (if since-ver
                   (push `(defun ,raw-acc (table)
                            ,@(when fdoc (list fdoc))
                            (declare (type ,struct-name table))
                            (when (>= (table-ref-length table) ,(+ fixed-offset off-size))
                              (,off-reader (table-ref-font-data table) ,off-expr)))
                         forms)
                   (push `(defun ,raw-acc (table)
                            ,@(when fdoc (list fdoc))
                            (declare (type ,struct-name table))
                            (,off-reader (table-ref-font-data table) ,off-expr))
                         forms))
               (if target-known
                   (push `(defun ,acc-name (table)
                            ,@(when fdoc (list fdoc))
                            (declare (type ,struct-name table))
                            (let ((off (,raw-acc table)))
                              (when (and off (not (zerop off)))
                                (,(zsym (format nil "READ-~A" target))
                                 (table-ref-font-data table)
                                 (+ (table-ref-offset table) off)))))
                         forms)
                   (push `(defun ,acc-name (table)
                            ,@(when fdoc (list fdoc))
                            (declare (type ,struct-name table))
                            (let ((off (,raw-acc table)))
                              (when (and off (not (zerop off)))
                                (font-data-slice (table-ref-font-data table) (+ (table-ref-offset table) off)))))
                         forms))
               (incf fixed-offset off-size)
               (when (and (null dynamic-terms) (null since-ver))
                 (incf min-size off-size)))))

          ;; Scalar field
          ((resolve-type-info ftype)
           (let* ((tinfo (resolve-type-info ftype))
                  (size (getf tinfo :size))
                  (reader (getf tinfo :reader)))
             (if since-ver
                 (push `(defun ,acc-name (table)
                          ,@(when fdoc (list fdoc))
                          (declare (type ,struct-name table))
                          (when (>= (table-ref-length table) ,(+ fixed-offset size))
                            (,reader (table-ref-font-data table) ,off-expr)))
                       forms)
                 (push `(defun ,acc-name (table)
                          ,@(when fdoc (list fdoc))
                          (declare (type ,struct-name table))
                          (,reader (table-ref-font-data table) ,off-expr))
                       forms))
             (when (null dynamic-terms)
               (let ((raw-acc (zsym (format nil "~A-~A-RAW" struct-name fname))))
                 (push `(declaim (inline ,raw-acc)) forms)
                 (push `(defun ,raw-acc (font-data offset)
                          (,reader font-data ,raw-off-expr))
                       forms)))
             (incf fixed-offset size)
             (when (and (null dynamic-terms) (null since-ver))
               (incf min-size size)))))))

    (when declaims
      (push `(declaim (inline ,@(nreverse declaims))) (cdr forms)))

    ;; Sanitize function
    (push `(defun ,san-name (font-data offset length)
             (declare (ignorable length) (type font-data font-data) (type (unsigned-byte 32) offset length))
             (unless (and (<= ,min-size length) (font-data-valid-range-p font-data offset ,min-size))
               (error 'font-out-of-bounds-error :pos offset :size ,min-size :length (font-data-length font-data)))
             ,@(nreverse array-bounds-checks)
             t)
          forms)

    ;; Read function
    (push `(defun ,read-name (font-data offset &optional (length (- (font-data-length font-data) offset)))
             (,san-name font-data offset length)
             (,ctor-name font-data offset length))
          forms)

    (nreverse forms)))

(defun emit-file-forms (items stream filename)
  (let ((*exports* '())
        (*print-case* :downcase)
        (*package* (find-package :zpb-otf))
        (all-forms '()))
    ;; 1. Enums & Flags
    (dolist (item items)
      (let ((kind (string-upcase (string (car item)))))
        (cond
          ((string-equal kind "ENUM")  (setf all-forms (append all-forms (emit-enum item))))
          ((string-equal kind "FLAGS") (setf all-forms (append all-forms (emit-flags item)))))))
    ;; 2. Records
    (dolist (item items)
      (when (string-equal (string (car item)) "RECORD")
        (setf all-forms (append all-forms (emit-record item)))))
    ;; 3. Tables & Formats
    (dolist (item items)
      (let ((kind (string-upcase (string (car item)))))
        (cond
          ((string-equal kind "TABLE")  (setf all-forms (append all-forms (emit-table item))))
          ((or (string-equal kind "FORMAT") (string-equal kind "FORMAT-TABLE"))
           (setf all-forms (append all-forms (emit-format item)))))))

    ;; Write file header
    (format stream ";;;; ~A — Generated OpenType tables~%" filename)
    (format stream ";;;; Generated automatically from OpenType sexp schema~%")
    (format stream ";;;; DO NOT EDIT DIRECTLY~%~%")
    (pprint '(in-package #:zpb-otf) stream)
    (terpri stream)
    (terpri stream)
    (when *exports*
      (pprint `(export '(,@(sort (mapcar #'zsym (copy-list *exports*)) #'string< :key #'symbol-name))) stream)
      (terpri stream)
      (terpri stream))

    ;; Pretty-print every generated form
    (dolist (f all-forms)
      (pprint f stream)
      (terpri stream)
      (terpri stream))
    *exports*))
